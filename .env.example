# Public hostname Caddy should serve (and fetch a TLS cert for)
MARGIN_DOMAIN=paper.example.com
# Sign-in: a shared group password, GitHub, or both.
MARGIN_PASSWORD=change-me

# GitHub login: create an OAuth app at https://github.com/settings/developers
# with callback URL https://<MARGIN_DOMAIN>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub usernames allowed in ("*" = anyone with GitHub)
MARGIN_GITHUB_ALLOW=
# Secret used to sign session cookies: `openssl rand -hex 32`
MARGIN_SECRET=
# Optional: a workspace Anthropic API key members can use if they haven't added
# their own (each member can add theirs in AI settings; usage bills that key).
ANTHROPIC_API_KEY=
# Optional: contact email for Crossref's polite pool (faster citation checks)
CROSSREF_MAILTO=

# Who can open projects: "workspace" (everyone signed in) or "members" (invite-only;
# default when MARGIN_GITHUB_ALLOW=*). Members mode requires GitHub sign-in.
MARGIN_ACCESS=workspace

# TeX Live image tag for the compile sandbox (latest-full has every class, ~5 GB)
TEXLIVE_IMAGE=texlive/texlive:latest-full
